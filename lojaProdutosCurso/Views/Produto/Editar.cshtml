@using lojaProdutosCurso.Dto.Produto
@model EditarProdutoDto

<div class="container mt-5">
    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <h2>Edição de Produto - @Model.Nome</h2>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Foto" />

        <div class="mb-1">
            <label class="form-check-label">Foto</label>
            <input class="form-control shadow-none" type="file" name="foto" />
        </div>
        <div class="mb-1">
            <label class="form-label">Nome:</label>
            <input class="form-control shadow-none" type="text" asp-for="Nome" />
            <span asp-validation-for="Nome" class="text-bg-danger"></span>
        </div>
        <div class="mb-1">
            <label class="form-label">Marca:</label>
            <input class="form-control shadow-none" type="text" asp-for="Marca" />
            <span asp-validation-for="Marca" class="text-bg-danger"></span>
        </div>
        <div class="mb-1">
            <label class="form-label">Valor:</label>
            <input class="form-control shadow-none" type="number" min="1" step="any" asp-for="Valor" />
            <span asp-validation-for="Valor" class="text-bg-danger"></span>
        </div>
        <div class="mb-1">
            <label class="form-label">Quantidade:</label>
            <input class="form-control shadow-none" type="number" min="1" step="any" asp-for="QuantidadeEstoque" />
            <span asp-validation-for="QuantidadeEstoque" class="text-bg-danger"></span>
        </div>
        <div class="mb-1">
            <label class="form-label">Categoria</label>
            <select asp-for="CategoriaModelId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nome", Model.CategoriaModelId))">
            </select>
            <span asp-validation-for="CategoriaModelId" class="text-bg-danger"></span>
        </div>
        <div class="d-flex mt-3">
            <button type="submit" class="btm btn-success w-50 mx-1"><i class="bi bi-plus-circle"></i>Editar</button>
            <a class="btn btn-info w-50" asp-action="Index"><i class="bi bi-arrow-left-circle"></i>Voltar</a>
        </div>
    </form>
</div>

        
 